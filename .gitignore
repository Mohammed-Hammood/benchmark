# ── Local config, secrets, logs ──────────────────────────────────────────────
# The root .env is NOT ignored: it holds COMPOSE_PARALLEL_LIMIT / COMPOSE_BAKE,
# which the compose setup relies on. Put real secrets in .env.local instead.
.env.local
.env.*.local
*.log
logs/

# ── Docker ───────────────────────────────────────────────────────────────────
docker-compose.override.yml

# ── Editors / OS ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ── Stray copies ─────────────────────────────────────────────────────────────
*copy.conf
